  "phrases": [
    {
      "hr": "Uvijek slušaj svoje tijelo.",
      "en": "Always listen to your body."
    },
    {
      "hr": "Ne preskači zagrijavanje.",
      "en": "Don't skip the warm-up."
    },
    {
      "hr": "Isteži se nakon treninga, nikada prije.",
      "en": "Stretch after training, never before."
    },
    {
      "hr": "Odmor je pasivan, bez kretanja.",
      "en": "Rest is passive, no moving around."
    },
    {
      "hr": "Odradi lakši trening ili otiđi u dugu šetnju.",
      "en": "Do an easier session or go for a long walk."
    },
    {
      "hr": "Ako si iscrpljen, odmor je dio napretka.",
      "en": "If you're wrecked, rest is part of progress."
    },
    {
      "hr": "Uvijek možeš prilagoditi intenzitet i prebaciti se na osjećaj.",
      "en": "You can always back off the intensity and go by feel."
    },
    {
      "hr": "Bitno je zadržati kontinuitet.",
      "en": "The key is consistency."
    },
    {
      "hr": "Nemoj biti nestrpljiv.",
      "en": "Don't be impatient."
    },
    {
      "hr": "Manje je više.",
      "en": "Less is more."
    },
    {
      "hr": "Tempo dio ne smije prelaziti 50% vremena trčanja toga dana.",
      "en": "Tempo work shouldn't be more than 50% of that day's run time."
    },
    {
      "hr": "Početnici kreću s dionicama od 1 minute.",
      "en": "Beginners start with 1-minute repeats."
    },
    {
      "hr": "Na brdu ćeš lakše podići intenzitet uz manje udaranja o podlogu.",
      "en": "Uphill you can raise intensity with less pounding."
    },
    {
      "hr": "Trčanje ograniči na maksimalno 30 minuta.",
      "en": "Cap the run at 30 minutes."
    },
    {
      "hr": "Nemoj trčati dan za danom.",
      "en": "Don't run on back-to-back days."
    },
    {
      "hr": "Drži kadencu između 170 i 180 koraka u minuti.",
      "en": "Keep cadence between 170 and 180 steps per minute."
    },
    {
      "hr": "Drži kukove, trup i glavu u ravnini.",
      "en": "Keep hips, torso and head in line."
    },
    {
      "hr": "Nauči plivati ravno, disati i orijentirati se.",
      "en": "Learn to swim straight, breathe and sight."
    },
    {
      "hr": "Što je voda hladnija, to sporije plivaj.",
      "en": "The colder the water, the slower you swim."
    },
    {
      "hr": "Drži se obale i plivaj u skupini.",
      "en": "Stay close to shore and swim in a group."
    },
    {
      "hr": "Pedaliranje nije samo pritiskanje pedale prema dolje.",
      "en": "Pedaling isn't just pushing down."
    },
    {
      "hr": "Prije svake vožnje provjeri tlak u gumama i kočnice.",
      "en": "Check tire pressure and brakes before every ride."
    },
    {
      "hr": "Koristi izotonik na treningu.",
      "en": "Use a sports drink in training."
    },
    {
      "hr": "Nemoj gladovati na treningu.",
      "en": "Don't go hungry in training."
    },
    {
      "hr": "Pij prije, za vrijeme i nakon treninga.",
      "en": "Drink before, during and after training."
    },
    {
      "hr": "Jedan trening tjedno odradi u vrućini.",
      "en": "Do one session a week in the heat."
    },
    {
      "hr": "Smanji trajanje treninga za 20-30%, a zadrži planirani intenzitet.",
      "en": "Cut the duration 20-30% but keep the planned intensity."
    },
    {
      "hr": "Postavi gornju granicu intenziteta.",
      "en": "Set an intensity ceiling."
    },
    {
      "hr": "Odaberi dvije utrke, jedna je uvijek rezerva.",
      "en": "Pick two races, one is always the backup."
    },
    {
      "hr": "Zaboravi na utrku do 48 sati prije starta.",
      "en": "Forget about the race until 48 hours before the start."
    },
    {
      "hr": "Odluku donesi brzo i drži je se do kraja.",
      "en": "Decide fast and stick with it to the end."
    },
    {
      "hr": "Nakon Ironmana savjetujem minimalno mjesec dana bez treninga.",
      "en": "After an Ironman I recommend at least a month off."
    },
    {
      "hr": "Plan nije Biblija, prilagođavaj ga dnevno.",
      "en": "The plan isn't the Bible, adjust it daily."
    },
    {
      "hr": "Mirna glava, jake noge.",
      "en": "Calm head, strong legs."
    },
    {
      "hr": "Uz moju podršku ćeš to razvaliti!",
      "en": "With my support you'll smash it!"
    },
    {
      "hr": "Ne zaboravi mi javiti rezultate!",
      "en": "Don't forget to send me your results!"
    },
    {
      "hr": "Javi se da složimo plan.",
      "en": "Get in touch so we can put a plan together."
    },
    {
      "hr": "Sve je moguće!",
      "en": "Anything is possible!"
    }
  ]
}
